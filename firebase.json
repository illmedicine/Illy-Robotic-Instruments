{
  "hosting": {
    "public": "site-next/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/livepay",
        "destination": "https://illmedicine.github.io/LivePay/",
        "type": 302
      },
      {
        "source": "/livepay/**",
        "destination": "https://illmedicine.github.io/LivePay/",
        "type": 302
      },
      {
        "source": "/PlatformManager/index.html",
        "destination": "/PlatformManager/",
        "type": 301
      },
      {
        "source": "/PlatformManager/app.html",
        "destination": "/PlatformManager/overview",
        "type": 301
      },
      {
        "source": "/PlatformManager/app",
        "destination": "/PlatformManager/overview",
        "type": 301
      },
      {
        "source": "/PlatformManager/app/**",
        "destination": "/PlatformManager/overview",
        "type": 301
      },
      {
        "source": "/PlatformManager/assets/showcase",
        "destination": "/PlatformManager/",
        "type": 301
      },
      {
        "source": "/PlatformManager/assets/showcase.html",
        "destination": "/PlatformManager/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/isocial/**",
        "destination": "/isocial/index.html"
      },
      {
        "source": "/IR-AIcademy/**",
        "destination": "/IR-AIcademy/index.html"
      },
      {
        "source": "/PlatformManager/**",
        "destination": "/PlatformManager/app.html"
      }
    ],
    "headers": [
      {
        "source": "/PlatformManager/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
